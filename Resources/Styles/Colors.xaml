<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Identity: ink-blue (focus, trust) + marigold (time, attention) -->
    <Color x:Key="Primary">#2B44A0</Color>
    <Color x:Key="PrimaryDark">#1F3280</Color>
    <Color x:Key="Accent">#F2A91B</Color>
    <Color x:Key="Success">#2F9E44</Color>
    <Color x:Key="Danger">#D9363E</Color>
    <Color x:Key="White">#FFFFFF</Color>

    <Color x:Key="PageLight">#F5F6FA</Color>
    <Color x:Key="PageDark">#0E1220</Color>
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="CardDark">#181E33</Color>
    <Color x:Key="FieldLight">#F5F6FA</Color>
    <Color x:Key="FieldDark">#10152A</Color>
    <Color x:Key="TextLight">#1B1F2E</Color>
    <Color x:Key="TextDark">#F1F3F9</Color>
    <Color x:Key="MutedLight">#667085</Color>
    <Color x:Key="MutedDark">#9AA3B8</Color>
    <Color x:Key="BorderLight">#E1E5EF</Color>
    <Color x:Key="BorderDark">#2A3352</Color>
    <Color x:Key="LinkDark">#8FA5F0</Color>
</ResourceDictionary>
