<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyActivity.ViewModels"
             x:Class="MyActivity.Views.ResetPasswordPage"
             x:DataType="vm:ResetPasswordViewModel"
             Title="Reset password"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24,32,24,24" Spacing="20">

            <VerticalStackLayout Spacing="4">
                <Label Text="Reset your password" StyleClass="Title" />
                <Label Text="Enter the Employee ID and email you signed up with on this device." StyleClass="Muted" />
            </VerticalStackLayout>

            <Border StyleClass="Card">
                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Employee ID" StyleClass="FieldLabel" />
                        <Border StyleClass="Field">
                            <Entry Text="{Binding EmployeeId}" ReturnType="Next" IsTextPredictionEnabled="False" />
                        </Border>
                        <Label Text="{Binding EmployeeIdError}" StyleClass="Error"
                               IsVisible="{Binding EmployeeIdError, Converter={StaticResource StringNotEmpty}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email" StyleClass="FieldLabel" />
                        <Border StyleClass="Field">
                            <Entry Text="{Binding Email}" Keyboard="Email" ReturnType="Next" IsTextPredictionEnabled="False" />
                        </Border>
                        <Label Text="{Binding EmailError}" StyleClass="Error"
                               IsVisible="{Binding EmailError, Converter={StaticResource StringNotEmpty}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="New password" StyleClass="FieldLabel" />
                        <Border StyleClass="Field">
                            <Entry Text="{Binding NewPassword}" IsPassword="True" ReturnType="Next" />
                        </Border>
                        <Label Text="{Binding NewPasswordError}" StyleClass="Error"
                               IsVisible="{Binding NewPasswordError, Converter={StaticResource StringNotEmpty}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Confirm new password" StyleClass="FieldLabel" />
                        <Border StyleClass="Field">
                            <Entry Text="{Binding ConfirmPassword}" IsPassword="True" ReturnType="Done"
                                   ReturnCommand="{Binding ResetCommand}" />
                        </Border>
                        <Label Text="{Binding ConfirmPasswordError}" StyleClass="Error"
                               IsVisible="{Binding ConfirmPasswordError, Converter={StaticResource StringNotEmpty}}" />
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}" StyleClass="Error" HorizontalTextAlignment="Center"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}" />

                    <Button Text="Update password" Command="{Binding ResetCommand}" IsEnabled="{Binding IsNotBusy}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Back to log in" StyleClass="Link" Command="{Binding BackCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
