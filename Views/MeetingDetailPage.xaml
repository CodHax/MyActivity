<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyActivity.ViewModels"
             xmlns:controls="clr-namespace:MyActivity.Views.Controls"
             x:Class="MyActivity.Views.MeetingDetailPage"
             x:DataType="vm:MeetingDetailViewModel"
             Title="Meeting details"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="20,36,20,28" Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Meeting" StyleClass="Title" />
                    <Label Text="Details" StyleClass="Muted" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Back" StyleClass="Link" Command="{Binding BackCommand}" VerticalOptions="Start" />
            </Grid><Border StyleClass="Card">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="22" />
                    <Label Text="{Binding DateText}" StyleClass="Muted" />
                    <Label Text="{Binding TimeText}" TextColor="{StaticResource Primary}" FontFamily="OpenSansSemibold" /><VerticalStackLayout Spacing="2">
                        <Label Text="Reminder" StyleClass="Muted" FontSize="12" />
                        <Label Text="{Binding ReminderText}" />
                    </VerticalStackLayout><VerticalStackLayout Spacing="2" IsVisible="{Binding HasLocation}">
                        <Label Text="Location" StyleClass="Muted" FontSize="12" />
                        <Label Text="{Binding Location}" />
                    </VerticalStackLayout><VerticalStackLayout Spacing="2" IsVisible="{Binding HasParticipants}">
                        <Label Text="Participants" StyleClass="Muted" FontSize="12" />
                        <Label Text="{Binding Participants}" />
                    </VerticalStackLayout><VerticalStackLayout Spacing="2" IsVisible="{Binding HasDescription}">
                        <Label Text="Description" StyleClass="Muted" FontSize="12" />
                        <Label Text="{Binding Description}" />
                    </VerticalStackLayout><VerticalStackLayout Spacing="2" IsVisible="{Binding HasNotes}">
                        <Label Text="Notes" StyleClass="Muted" FontSize="12" />
                        <Label Text="{Binding Notes}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border><Label Text="{Binding ErrorMessage}" StyleClass="Error" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}" /><Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Edit" Command="{Binding EditCommand}" />
                <Button Grid.Column="1" Text="Delete" StyleClass="Outline" Command="{Binding DeleteCommand}"
                        TextColor="{StaticResource Danger}" BorderColor="{StaticResource Danger}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
