<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyActivity.ViewModels"
             xmlns:controls="clr-namespace:MyActivity.Views.Controls"
             x:Class="MyActivity.Views.TransactionHistoryPage"
             x:DataType="vm:TransactionHistoryViewModel"
             Title="Transactions"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="20,36,20,0" RowSpacing="10">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="Transactions" StyleClass="Title" />
                <Label Text="{Binding CountText}" StyleClass="Muted" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Back" StyleClass="Link" Command="{Binding BackCommand}" VerticalOptions="Start" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="0">
            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding TypeFilters}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilterOption">
                        <Border StrokeThickness="1" Padding="14,8" Margin="0,0,8,8" BackgroundColor="Transparent"
                                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectCommand}" /></Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{Binding Title}" FontSize="14">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout><FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding DateFilters}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilterOption">
                        <Border StrokeThickness="1" Padding="14,8" Margin="0,0,8,8" BackgroundColor="Transparent"
                                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectCommand}" /></Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{Binding Title}" FontSize="14">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding IsCustomDate}">
                <Border StyleClass="Field"><DatePicker Date="{Binding FromDate}" MaximumDate="{Binding MaxDate}" /></Border>
                <Border Grid.Column="1" StyleClass="Field"><DatePicker Date="{Binding ToDate}" MaximumDate="{Binding MaxDate}" /></Border>
            </Grid>
            <Border StyleClass="Field"><Picker Title="Category" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" /></Border>
        </VerticalStackLayout>

        <Border Grid.Row="3" StyleClass="Card" Padding="14">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                <VerticalStackLayout><Label Text="Credit" StyleClass="Muted" FontSize="12" /><Label Text="{Binding CreditText}" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource Success}" /></VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1"><Label Text="Debit" StyleClass="Muted" FontSize="12" /><Label Text="{Binding DebitText}" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource Danger}" /></VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2"><Label Text="Balance" StyleClass="Muted" FontSize="12" /><Label Text="{Binding BalanceText}" FontSize="13" FontFamily="OpenSansSemibold" /></VerticalStackLayout>
            </Grid>
        </Border>

        <CollectionView Grid.Row="4" ItemsSource="{Binding Items}" SelectionMode="None" Margin="0,4,0,0">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="0,40" Spacing="6" HorizontalOptions="Center">
                    <Label Text="No transactions found" StyleClass="Heading" HorizontalOptions="Center" />
                    <Label Text="Try changing the filters." StyleClass="Muted" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:TransactionItem">
                    <Border StyleClass="Card" Padding="14" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EditCommand}" /></Grid.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Description}" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding CategoryText}" StyleClass="Muted" />
                                <Label Text="{Binding DateText}" StyleClass="Muted" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding AmountText}" TextColor="{Binding AmountColor}" FontFamily="OpenSansSemibold" VerticalOptions="Start" />
                            <Button Grid.Row="1" Grid.ColumnSpan="2" Text="Delete" StyleClass="Link" HeightRequest="34" FontSize="13"
                                    HorizontalOptions="End" TextColor="{StaticResource Danger}" Command="{Binding DeleteCommand}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
