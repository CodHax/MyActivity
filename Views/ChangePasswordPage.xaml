<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyActivity.ViewModels"
             xmlns:controls="clr-namespace:MyActivity.Views.Controls"
             x:Class="MyActivity.Views.ChangePasswordPage"
             x:DataType="vm:ChangePasswordViewModel"
             Title="Change password"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="20,36,20,28" Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Change password" StyleClass="Title" />
                    <Label Text="Use at least 8 characters with a number." StyleClass="Muted" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Back" StyleClass="Link" Command="{Binding BackCommand}" VerticalOptions="Start" />
            </Grid><Border StyleClass="Card">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Current password" StyleClass="FieldLabel" />
                        <Border StyleClass="Field"><Entry Text="{Binding CurrentPassword}" IsPassword="True" /></Border>
                        <Label Text="{Binding CurrentError}" StyleClass="Error" IsVisible="{Binding CurrentError, Converter={StaticResource StringNotEmpty}}" />
                    </VerticalStackLayout><VerticalStackLayout Spacing="6">
                        <Label Text="New password" StyleClass="FieldLabel" />
                        <Border StyleClass="Field"><Entry Text="{Binding NewPassword}" IsPassword="True" /></Border>
                        <Label Text="{Binding NewError}" StyleClass="Error" IsVisible="{Binding NewError, Converter={StaticResource StringNotEmpty}}" />
                    </VerticalStackLayout><VerticalStackLayout Spacing="6">
                        <Label Text="Confirm new password" StyleClass="FieldLabel" />
                        <Border StyleClass="Field"><Entry Text="{Binding ConfirmPassword}" IsPassword="True" /></Border>
                        <Label Text="{Binding ConfirmError}" StyleClass="Error" IsVisible="{Binding ConfirmError, Converter={StaticResource StringNotEmpty}}" />
                    </VerticalStackLayout><Label Text="{Binding ErrorMessage}" StyleClass="Error" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}" /><Button Text="Update password" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
