<Project Sdk="Microsoft.NET.Sdk">
  <!-- Self-contained logic checks: no NuGet packages, no MAUI. Run with:  dotnet run  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
    <RootNamespace>MyActivity.LogicTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pure-logic files linked straight from the app project -->
    <Compile Include="..\..\Helpers\PasswordHasher.cs" Link="Linked\PasswordHasher.cs" />
    <Compile Include="..\..\Helpers\Validators.cs" Link="Linked\Validators.cs" />
    <Compile Include="..\..\Helpers\WorkingDays.cs" Link="Linked\WorkingDays.cs" />
    <Compile Include="..\..\Helpers\FinancialCalculators.cs" Link="Linked\FinancialCalculators.cs" />
    <Compile Include="..\..\Helpers\BasicCalculator.cs" Link="Linked\BasicCalculator.cs" />
    <Compile Include="..\..\Helpers\MoneyFormat.cs" Link="Linked\MoneyFormat.cs" />
  </ItemGroup>
</Project>
